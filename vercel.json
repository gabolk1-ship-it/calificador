{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/validar/:cedula",
      "destination": "/api/validar?cedula=:cedula"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}